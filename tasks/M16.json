{
  "$schema": "qqq-task-contract/v1",
  "task_id": "M16",
  "title": "Massive read-only real-time observation, configurable refresh, and paper-only notifications",
  "status": "approved",
  "change_class": "integration",
  "route_id": "realtime_observation",
  "role": "integrator",
  "base_ref": "verification-baseline-v3.21",
  "task_contract_authority": "trusted_ref_only",
  "requires_user_approval": true,
  "baseline_promotion_required": true,
  "required_context": [
    "AGENTS.md",
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "docs/QQQ_THERMOMETER_GOVERNANCE_BOUNDARIES.md",
    "docs/PERSONAL_USE_GOVERNANCE.md",
    "docs/QQQ_VERIFICATION_GOVERNANCE_BASELINE.md",
    "docs/QQQ_THERMOMETER_ARCHITECTURE.md",
    "docs/QQQ_THERMOMETER_MODULE_PLAN.md",
    "tasks/M15.json",
    "contracts/openapi.json",
    "src/storage/market_data.py",
    "src/storage/normalization.py",
    "src/storage/indicators.py",
    "src/thermometer/regime.py",
    "src/thermometer/explanation.py",
    "src/api/read_api.py",
    "src/api/http_server.py",
    "frontend/demo/README.md",
    "frontend/demo/index.html",
    "frontend/demo/styles.css",
    "frontend/demo/app.js",
    "verification/README.md",
    "verification/control/policy.json",
    "verification/control/protected_manifest.json"
  ],
  "allowed_write_paths": [
    "configs/realtime/",
    "src/realtime/",
    "src/notifications/",
    "src/api/live_api.py",
    "src/api/live_server.py",
    "frontend/m16/",
    "tests/realtime/",
    "tests/frontend/m16/",
    "tests/e2e/m16/",
    "docs/realtime/"
  ],
  "protected_write_paths": [],
  "forbidden_write_paths": [
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "tasks/",
    "docs/DOCUMENT_REGISTRY.json",
    "verification/",
    ".github/workflows/verification.yml",
    "configs/frozen/",
    "contracts/",
    "research/",
    "data/",
    "artifacts/",
    "secrets/",
    ".env",
    ".env.*",
    "frontend/demo/",
    "frontend/shell/",
    "frontend/dashboard/",
    "frontend/m14/",
    "src/thermometer/",
    "src/storage/",
    "src/jobs/",
    "src/api/read_api.py",
    "src/api/http_server.py"
  ],
  "invariants": [
    "m16_is_additive_and_does_not_change_m15_or_existing_strategy_runtime_behavior",
    "massive_is_read_only_market_data_only_and_api_key_never_enters_frontend_logs_or_repository",
    "default_refresh_interval_is_900_seconds_and_is_changed_only_by_versioned_non_secret_config",
    "internal_event_time_is_normalized_to_utc_and_user_display_timezone_is_Asia_Shanghai",
    "source_timestamps_and_provider_latency_are_preserved_and_not_silently_relabelled",
    "intraday_observation_is_provisional_and_cannot_create_or_change_confirmed_target_weights",
    "confirmed_state_reuses_existing_m04_to_m07_logic_at_the_declared_close_boundary",
    "invalid_config_missing_data_not_entitled_rate_limited_and_stale_inputs_fail_closed",
    "polling_is_idempotent_deduplicated_reconnectable_and_does_not_spin_on_errors",
    "sse_is_read_only_local_or_private_only_and_reconnects_without_duplicate_notifications",
    "notifications_are_emitted_only_for_declared_state_target_quality_or_service_events",
    "browser_has_no_external_market_data_connection_and_no_secret_or_broker_capability",
    "frontend_m16_borrows_information_hierarchy_only_and_does_not_modify_frontend_demo_shell_dashboard_or_m14",
    "no_broker_order_transfer_public_deployment_or_automatic_real_trading_is_added",
    "all_history_strategy_results_and_m15_artifacts_remain_unchanged"
  ],
  "acceptance_gates": [
    "candidate_commit",
    "workspace_clean",
    "trusted_ref_separation",
    "policy_integrity",
    "context_registry",
    "task_scope",
    "ownership_scope",
    "protected_scope",
    "protected_manifest",
    "test_integrity",
    "developer_tests",
    "independent_tests",
    "golden_dataset",
    "negative_tests",
    "negative_fault_inputs",
    "fault_injection",
    "controlled_environment",
    "evidence_integrity"
  ],
  "stop_conditions": [
    "task_contract_missing_from_trusted_ref",
    "required_context_missing",
    "router_or_registry_malformed",
    "candidate_changes_outside_allowed_write_paths",
    "m15_or_existing_frontend_files_changed",
    "strategy_or_frozen_api_contract_changed",
    "massive_api_key_is_committed_logged_returned_to_browser_or_sent_as_query_parameter",
    "provider_is_not_entitled_symbol_is_not_found_or_rate_limit_is_treated_as_valid_data",
    "future_timestamp_out_of_order_duplicate_or_stale_data_is_published_as_confirmed",
    "provisional_observation_changes_target_weights_or_paper_ledger",
    "sse_or_notification_replays_duplicate_events_without_idempotency",
    "browser_opens_external_market_data_or_broker_connection",
    "public_deployment_broker_order_transfer_scheduler_or_real_trading_capability_is_added",
    "existing_demo_shell_dashboard_m14_or_m15_artifact_is_overwritten",
    "test_failure_or_skipped_protected_test"
  ],
  "expected_artifacts": [
    "candidate_commit",
    "realtime_config_manifest",
    "massive_source_contract_report",
    "local_evidence_bundle",
    "ci_evidence_bundle",
    "realtime_replay_and_quality_report",
    "sse_notification_dedup_report",
    "private_access_and_secret_scan_report",
    "m16_private_release_manifest_with_rollback_reference"
  ],
  "completion_status": {
    "builder_may_report": [
      "READY_FOR_VERIFICATION",
      "BASELINE_PROMOTION_REQUIRED"
    ],
    "builder_may_not_report": [
      "VERIFIED",
      "CI_VERIFIED",
      "PRODUCT_BASELINE"
    ]
  }
}
