{
  "$schema": "qqq-task-contract/v1",
  "task_id": "M01",
  "title": "Strategy and Version Contract",
  "status": "approved",
  "change_class": "strategy_domain",
  "route_id": "strategy_domain",
  "role": "domain_builder",
  "base_ref": "verification-baseline-v2",
  "task_contract_authority": "trusted_ref_only",
  "requires_user_approval": true,
  "baseline_promotion_required": true,
  "required_context": [
    "AGENTS.md",
    "src/thermometer/AGENTS.md",
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "configs/frozen/strategy_contract.json",
    "docs/QQQ_THERMOMETER_GOVERNANCE_BOUNDARIES.md",
    "docs/QQQ_VERIFICATION_GOVERNANCE_BASELINE.md",
    "docs/QQQ_THERMOMETER_ARCHITECTURE.md",
    "docs/QQQ_THERMOMETER_MODULE_PLAN.md",
    "verification/README.md",
    "verification/control/policy.json",
    "verification/control/protected_manifest.json"
  ],
  "allowed_write_paths": [
    "src/thermometer/",
    "tests/unit/",
    "tests/data_contracts/",
    "tests/integration/",
    "tests/e2e/"
  ],
  "protected_write_paths": [],
  "forbidden_write_paths": [
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "tasks/",
    "docs/DOCUMENT_REGISTRY.json",
    "verification/",
    ".github/workflows/verification.yml",
    "configs/frozen/",
    "contracts/",
    "frontend/",
    "src/api/",
    "src/storage/",
    "src/jobs/",
    "src/web/",
    "research/",
    "docs/reference/"
  ],
  "invariants": [
    "frozen_strategy_contract_unchanged",
    "api_contract_unchanged",
    "legacy_strategy_version_name_unchanged",
    "no_new_indicators_or_parameters",
    "no_data_refresh_or_backtest_change",
    "no_real_broker_or_order_capability",
    "no_strategy_rule_reimplementation_in_contract_layer",
    "no_lookahead_in_signal_execution_schema",
    "same_input_same_contract_object",
    "json_standard_library_compatible"
  ],
  "acceptance_gates": [
    "candidate_commit",
    "workspace_clean",
    "trusted_ref_separation",
    "policy_integrity",
    "context_registry",
    "task_scope",
    "ownership_scope",
    "protected_scope",
    "protected_manifest",
    "test_integrity",
    "developer_tests",
    "independent_tests",
    "golden_dataset",
    "negative_tests",
    "negative_fault_inputs",
    "fault_injection",
    "controlled_environment",
    "evidence_integrity"
  ],
  "stop_conditions": [
    "task_contract_missing_from_trusted_ref",
    "required_context_missing",
    "router_or_registry_malformed",
    "candidate_changes_outside_allowed_write_paths",
    "strategy_or_api_contract_changed",
    "legacy_strategy_version_renamed_or_reinterpreted",
    "new_indicator_or_parameter_added",
    "signal_execution_date_schema_is_ambiguous",
    "test_failure_or_skipped_protected_test"
  ],
  "expected_artifacts": [
    "candidate_commit",
    "local_evidence_bundle",
    "ci_evidence_bundle",
    "strategy_version_contract_schema",
    "contract_determinism_report"
  ],
  "completion_status": {
    "builder_may_report": ["READY_FOR_VERIFICATION", "BASELINE_PROMOTION_REQUIRED"],
    "builder_may_not_report": ["VERIFIED", "CI_VERIFIED", "PRODUCT_BASELINE"]
  }
}
