{
  "$schema": "qqq-task-contract/v1",
  "task_id": "M15",
  "title": "Full-chain verification and private personal release acceptance",
  "status": "approved",
  "change_class": "integration",
  "route_id": "release_acceptance",
  "role": "integrator",
  "base_ref": "verification-baseline-v3.19",
  "task_contract_authority": "trusted_ref_only",
  "requires_user_approval": true,
  "baseline_promotion_required": true,
  "required_context": [
    "AGENTS.md",
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "docs/QQQ_THERMOMETER_GOVERNANCE_BOUNDARIES.md",
    "docs/QQQ_VERIFICATION_GOVERNANCE_BASELINE.md",
    "docs/PERSONAL_USE_GOVERNANCE.md",
    "docs/WORKTREE_RESTORE_PROTOCOL.md",
    "docs/QQQ_THERMOMETER_ARCHITECTURE.md",
    "docs/QQQ_THERMOMETER_MODULE_PLAN.md",
    "tasks/M14.json",
    "contracts/openapi.json",
    "src/thermometer/regime.py",
    "src/thermometer/explanation.py",
    "src/thermometer/target_weights.py",
    "src/storage/sqlite_store.py",
    "src/storage/paper_portfolio.py",
    "src/jobs/orchestrator.py",
    "src/api/read_api.py",
    "src/api/http_server.py",
    "tests/integration/test_sqlite_storage.py",
    "tests/integration/test_paper_portfolio.py",
    "tests/integration/test_job_orchestrator.py",
    "tests/integration/test_read_api.py",
    "tests/e2e/test_contract_e2e.py",
    "tests/e2e/test_regime_e2e.py",
    "tests/e2e/test_target_weights_e2e.py",
    "verification/README.md",
    "verification/control/policy.json",
    "verification/control/protected_manifest.json"
  ],
  "allowed_write_paths": [
    "tests/e2e/",
    "docs/release/"
  ],
  "protected_write_paths": [],
  "forbidden_write_paths": [
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "tasks/",
    "docs/DOCUMENT_REGISTRY.json",
    "verification/",
    ".github/workflows/verification.yml",
    "configs/frozen/",
    "contracts/",
    "src/",
    "frontend/",
    "research/",
    "data/",
    "artifacts/",
    "secrets/",
    ".env",
    ".env.*"
  ],
  "invariants": [
    "m15_is_final_acceptance_only_and_does_not_change_strategy_or_runtime_behavior",
    "full_chain_reuses_existing_m01_to_m14_components_without_a_second_strategy_or_client_recalculation",
    "release_is_local_or_private_network_only_and_paper_only",
    "backup_restore_round_trip_is_independent_and_content_equivalent",
    "localhost_binding_and_optional_token_access_control_are_enforced",
    "release_manifest_and_logs_contain_no_secret_or_account_credential",
    "fault_recovery_is_terminal_or_resumable_without_publishing_partial_results",
    "rollback_points_to_an_explicit_previous_trusted_baseline_without_mutating_history",
    "twenty_trading_session_paper_shadow_records_daily_signal_target_execution_cost_nav_quality_and_reconciliation",
    "release_metadata_pins_strategy_version_data_source_frequency_access_scope_disclaimer_and_rollback_reference",
    "no_public_deployment_broker_order_transfer_scheduler_or_external_market_data_capability_is_added",
    "no_history_or_strategy_result_is_deleted_or_overwritten"
  ],
  "acceptance_gates": [
    "candidate_commit",
    "workspace_clean",
    "trusted_ref_separation",
    "policy_integrity",
    "context_registry",
    "task_scope",
    "ownership_scope",
    "protected_scope",
    "protected_manifest",
    "test_integrity",
    "developer_tests",
    "independent_tests",
    "golden_dataset",
    "negative_tests",
    "negative_fault_inputs",
    "fault_injection",
    "controlled_environment",
    "evidence_integrity"
  ],
  "stop_conditions": [
    "task_contract_missing_from_trusted_ref",
    "required_context_missing",
    "router_or_registry_malformed",
    "candidate_changes_outside_allowed_write_paths",
    "strategy_or_api_contract_changed",
    "existing_strategy_or_runtime_logic_is_reimplemented_or_changed",
    "paper_shadow_uses_future_data_or_unapproved_external_service",
    "backup_restore_is_not_independent_or_content_equivalence_fails",
    "private_access_control_allows_non_localhost_or_missing_required_token",
    "release_manifest_or_logs_contain_secrets_credentials_or_account_identifiers",
    "partial_or_failed_pipeline_is_published_as_success",
    "rollback_reference_is_missing_or_points_to_untrusted_mutable_state",
    "paper_shadow_has_fewer_than_twenty_valid_trading_sessions_or_missing_daily_reconciliation",
    "public_deployment_broker_order_transfer_scheduler_or_real_trading_capability_is_added",
    "history_or_ledger_is_deleted_or_overwritten",
    "test_failure_or_skipped_protected_test"
  ],
  "expected_artifacts": [
    "candidate_commit",
    "local_evidence_bundle",
    "ci_evidence_bundle",
    "full_chain_e2e_report",
    "backup_restore_report",
    "private_access_and_secret_scan_report",
    "fault_recovery_and_rollback_report",
    "paper_shadow_20_sessions_report",
    "private_release_manifest_with_rollback_reference"
  ],
  "completion_status": {
    "builder_may_report": [
      "READY_FOR_VERIFICATION",
      "BASELINE_PROMOTION_REQUIRED"
    ],
    "builder_may_not_report": [
      "VERIFIED",
      "CI_VERIFIED",
      "PRODUCT_BASELINE"
    ]
  }
}
