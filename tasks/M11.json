{
  "$schema": "qqq-task-contract/v1",
  "task_id": "M11",
  "title": "Idempotent Manual Pipeline and Run State",
  "status": "approved",
  "change_class": "backend",
  "route_id": "backend",
  "role": "backend_builder",
  "base_ref": "verification-baseline-v3.11",
  "task_contract_authority": "trusted_ref_only",
  "requires_user_approval": true,
  "baseline_promotion_required": true,
  "required_context": [
    "AGENTS.md",
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "docs/QQQ_THERMOMETER_GOVERNANCE_BOUNDARIES.md",
    "docs/QQQ_VERIFICATION_GOVERNANCE_BASELINE.md",
    "docs/PERSONAL_USE_GOVERNANCE.md",
    "docs/QQQ_THERMOMETER_ARCHITECTURE.md",
    "docs/QQQ_THERMOMETER_MODULE_PLAN.md",
    "tasks/M10.json",
    "src/api/AGENTS.md",
    "src/storage/sqlite_store.py",
    "src/storage/paper_portfolio.py",
    "src/thermometer/regime.py",
    "src/thermometer/target_weights.py",
    "contracts/openapi.json",
    "verification/README.md",
    "verification/control/policy.json",
    "verification/control/protected_manifest.json"
  ],
  "allowed_write_paths": [
    "src/jobs/",
    "tests/integration/"
  ],
  "protected_write_paths": [],
  "forbidden_write_paths": [
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "tasks/",
    "docs/DOCUMENT_REGISTRY.json",
    "verification/",
    ".github/workflows/verification.yml",
    "configs/frozen/",
    "contracts/",
    "src/api/",
    "src/storage/",
    "src/thermometer/",
    "src/web/",
    "frontend/",
    "research/",
    "data/"
  ],
  "invariants": [
    "frozen_strategy_contract_unchanged",
    "frozen_openapi_contract_unchanged",
    "router_ownership_and_verification_policy_unchanged",
    "pipeline_order_is_refresh_calculate_simulate_publish",
    "manual_trigger_only_and_no_scheduler_or_import_time_execution",
    "request_requires_idempotency_strategy_data_dates_and_input_manifest",
    "every_accepted_request_has_a_unique_run_id",
    "run_states_are_append_only_and_follow_declared_transitions",
    "same_idempotency_replay_returns_existing_run_without_reinvoking_stages",
    "conflicting_same_idempotency_input_is_rejected",
    "stage_context_is_bound_to_run_request_and_manifest",
    "quality_failure_stale_partial_or_needs_review_is_visible_and_fail_closed",
    "publish_requires_current_four_stage_outputs_all_ok_quality_and_snapshot",
    "failure_never_relabels_old_output_as_new_published_result",
    "unfinished_run_can_resume_from_durable_transition_without_duplicate_history",
    "timeout_is_bounded_and_no_automatic_infinite_retry_exists",
    "concurrent_duplicate_requests_produce_one_execution_and_one_run",
    "no_strategy_indicator_weight_or_execution_rule_is_recomputed_or_changed",
    "repository_boundary_is_used_and_historical_records_are_not_updated_or_deleted",
    "no_network_broker_order_secret_or_external_service",
    "stdlib_only_no_new_runtime_dependency",
    "no_api_schema_or_frontend_change"
  ],
  "acceptance_gates": [
    "candidate_commit",
    "workspace_clean",
    "trusted_ref_separation",
    "policy_integrity",
    "context_registry",
    "task_scope",
    "ownership_scope",
    "protected_scope",
    "protected_manifest",
    "test_integrity",
    "developer_tests",
    "independent_tests",
    "golden_dataset",
    "negative_tests",
    "negative_fault_inputs",
    "fault_injection",
    "controlled_environment",
    "evidence_integrity"
  ],
  "stop_conditions": [
    "task_contract_missing_from_trusted_ref",
    "required_context_missing",
    "router_or_registry_malformed",
    "candidate_changes_outside_allowed_write_paths",
    "strategy_or_api_contract_changed",
    "pipeline_stage_order_is_changed_or_stage_is_skipped",
    "scheduler_import_time_or_real_trade_execution_is_added",
    "request_accepts_missing_or_unbounded_idempotency_or_manifest",
    "same_key_different_input_is_overwritten_or_reexecuted",
    "stage_output_is_not_bound_to_current_run_or_manifest",
    "stale_partial_failed_or_needs_review_is_published_as_confirmed",
    "publish_runs_after_a_failed_or_missing_stage",
    "old_snapshot_is_published_as_new_run_output",
    "restart_loses_state_duplicates_transitions_or_replays_completed_stages",
    "timeout_causes_unbounded_retry_or_hidden_background_work",
    "concurrent_duplicate_requests_create_multiple_runs",
    "repository_is_bypassed_or_historical_run_records_are_mutated",
    "network_broker_order_secret_or_new_dependency_is_added",
    "test_failure_or_skipped_protected_test"
  ],
  "expected_artifacts": [
    "candidate_commit",
    "local_evidence_bundle",
    "ci_evidence_bundle",
    "job_request_and_state_transition_contract",
    "run_manifest_and_quality_report",
    "idempotency_concurrency_and_restart_report",
    "timeout_partial_failure_and_no_publish_report",
    "manual_only_no_scheduler_no_order_boundary_report"
  ],
  "completion_status": {
    "builder_may_report": [
      "READY_FOR_VERIFICATION",
      "BASELINE_PROMOTION_REQUIRED"
    ],
    "builder_may_not_report": [
      "VERIFIED",
      "CI_VERIFIED",
      "PRODUCT_BASELINE"
    ]
  }
}
