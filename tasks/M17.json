  "invariants": [
    "m17_is_additive_and_does_not_change_m15_m16_or_existing_frontend_runtime_behavior",
    "massive_api_key_is_process_environment_only_and_never_enters_browser_logs_or_repository",
    "unified_portal_uses_localhost_only_and_preserves_original_module_urls",
    "strategy_state_and_target_weights_are_read_from_existing_confirmed_api_not_recomputed_in_browser",
    "intraday_massive_observations_remain_provisional_and_cannot_change_confirmed_target_weights",
    "paper_rebalance_plan_is_read_only_preview_with_explicit_paper_only_and_order_created_false",
    "paper_plan_requires_explicit_local_holdings_input_and_never_scrapes_broker_accounts",
    "data_quality_missing_api_or_unavailable_confirmed_api_fail_closed",
    "display_timezone_is_Asia_Shanghai_and_internal_event_times_remain_UTC",
    "no_broker_order_transfer_public_deployment_or_automatic_real_trading_is_added",
    "no_frozen_strategy_or_openapi_contract_is_changed",
    "all_history_strategy_results_m15_artifacts_m16_code_and_original_pages_remain_unchanged"
  ],
  "acceptance_gates": [
    "candidate_commit",
    "workspace_clean",
    "trusted_ref_separation",
    "policy_integrity",
    "context_registry",
    "task_scope",
    "ownership_scope",
    "protected_scope",
    "protected_manifest",
    "test_integrity",
    "developer_tests",
    "independent_tests",
    "golden_dataset",
    "negative_tests",
    "negative_fault_inputs",
    "fault_injection",
    "controlled_environment",
    "evidence_integrity"
  ],
  "stop_conditions": [
    "task_contract_missing_from_trusted_ref",
    "required_context_missing",
    "router_or_registry_malformed",
    "candidate_changes_outside_allowed_write_paths",
    "m15_m16_or_existing_frontend_files_changed",
    "strategy_or_frozen_api_contract_changed",
    "massive_api_key_is_committed_logged_returned_to_browser_or_sent_as_query_parameter",
    "confirmed_target_is_recomputed_from_intraday_data",
    "paper_plan_is_submitted_as_an_order_or_writes_a_broker_account",
    "external_or_non_loopback_api_url_is_configured",
    "public_deployment_broker_order_transfer_scheduler_or_real_trading_capability_is_added",
    "test_failure_or_skipped_protected_test"
  ],
  "expected_artifacts": [
    "candidate_commit",
    "m17_runtime_config_manifest",
    "unified_portal_contract_report",
    "paper_rebalance_plan_report",
    "local_evidence_bundle",
    "ci_evidence_bundle",
    "m17_private_release_manifest_with_rollback_reference"
  ],
  "completion_status": {
