  "invariants": [
    "frozen_strategy_contract_unchanged",
    "frozen_openapi_contract_unchanged",
    "router_ownership_and_verification_policy_unchanged",
    "replay_and_performance_views_are_presentation_only_and_consume_versioned_get_responses",
    "historical_date_filters_and_as_of_values_are_passed_to_the_backend_without_client_side_future_data_selection",
    "historical_rows_show_signal_execution_quality_and_missing_fields_explicitly_without_filling_or_interpolating",
    "performance_curve_and_metrics_are_rendered_from_backend_fields_without_client_recomputation",
    "annual_returns_drawdowns_and_duration_are_backend_provenance_fields_and_never_browser_derived",
    "qqq_benchmark_period_price_basis_and_alignment_are_displayed_only_when_backend_provides_them",
    "named_cost_stress_scenarios_are_displayed_only_from_backend_returned_values_without_client_recalculation_or_override_of_frozen_cost_contract",
    "failed_years_empty_curves_partial_data_and_needs_review_states_are_visible_and_fail_closed",
    "ledger_rows_are_read_only_and_provenance_metadata_is_visible",
    "strategy_data_code_versions_run_ids_evidence_refs_and_quality_are_visible_when_available",
    "untrusted_api_text_is_rendered_without_raw_html_injection",
    "no_performance_number_is_presented_as_a_future_return_or_drawdown_guarantee",
    "no_m15_backup_security_release_or_public_deployment_workflow_is_added",
    "no_paper_confirmation_broker_order_transfer_secret_or_account_permission_capability",
    "no_external_market_data_source_or_unapproved_remote_service",
    "no_large_ui_runtime_dependency_without_separate_approval",
    "no_api_schema_backend_strategy_storage_or_scheduler_change"
  ],
  "acceptance_gates": [
    "candidate_commit",
    "workspace_clean",
    "trusted_ref_separation",
    "policy_integrity",
    "context_registry",
    "task_scope",
    "ownership_scope",
    "protected_scope",
    "protected_manifest",
    "test_integrity",
    "developer_tests",
    "independent_tests",
    "golden_dataset",
    "negative_tests",
    "negative_fault_inputs",
    "fault_injection",
    "controlled_environment",
    "evidence_integrity"
  ],
  "stop_conditions": [
    "task_contract_missing_from_trusted_ref",
    "required_context_missing",
    "router_or_registry_malformed",
    "candidate_changes_outside_allowed_write_paths",
    "strategy_or_api_contract_changed",
    "frontend_selects_or_fills_future_historical_data",
    "frontend_recomputes_annual_returns_drawdowns_benchmark_or_cost_stress",
    "missing_or_failed_years_are_hidden_or_silently_dropped",
    "qqq_benchmark_or_cost_assumptions_are_client_invented_or_misaligned",
    "frontend_relabels_or_overrides_frozen_default_or_stress_cost_scenarios",
    "partial_stale_failed_or_needs_review_data_is_presented_as_complete",
    "performance_is_presented_as_a_future_prediction_or_guarantee",
    "untrusted_api_text_is_injected_as_raw_html",
    "ledger_view_can_mutate_paper_records",
    "m15_backup_security_release_or_public_deployment_workflow_is_added",
    "paper_confirmation_broker_order_transfer_secret_account_permission_or_external_market_data_capability_is_added",
    "large_unapproved_ui_dependency_is_added",
    "api_backend_storage_strategy_or_scheduler_is_changed",
    "test_failure_or_skipped_protected_test"
  ],
  "expected_artifacts": [
    "candidate_commit",
    "local_evidence_bundle",
    "ci_evidence_bundle",
    "replay_date_boundary_report",
    "performance_metric_provenance_report",
    "benchmark_alignment_report",
    "cost_stress_provenance_report",
    "audit_manifest_report",
    "no_future_data_or_performance_promise_boundary_report"
  ],
  "completion_status": {
    "builder_may_report": [
      "READY_FOR_VERIFICATION",
      "BASELINE_PROMOTION_REQUIRED"
    ],
    "builder_may_not_report": [
      "VERIFIED",
      "CI_VERIFIED",
      "PRODUCT_BASELINE"
    ]
  }
}
