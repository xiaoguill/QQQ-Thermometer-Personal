  "invariants": [
    "frozen_strategy_contract_unchanged",
    "api_contract_unchanged",
    "router_ownership_and_verification_policy_unchanged",
    "target_input_is_the_verified_m07_candidate_snapshot_not_client_weights",
    "paper_only_candidate_only_and_not_order_ready",
    "execution_date_is_the_target_next_trading_session",
    "all_execution_prices_are_explicit_input_for_the_execution_date",
    "no_network_data_fetch_broker_connection_or_order_capability",
    "price_basis_is_explicit_and_adjusted_prices_do_not_double_count_dividends_or_splits",
    "unadjusted_corporate_actions_are_explicitly_applied_and_ledgered",
    "initial_cash_costs_slippage_and_fractional_share_policy_are_versioned_and_deterministic",
    "positions_are_non_negative_and_cash_cannot_become_negative",
    "sell_before_buy_ordering_is_deterministic",
    "nav_reconciliation_identity_is_preserved",
    "signal_date_execution_date_strategy_version_and_target_hash_are_preserved",
    "ledger_and_portfolio_snapshots_are_append_only",
    "same_input_replay_is_idempotent_and_conflicting_same_day_input_is_rejected",
    "restart_recovers_from_repository_without_reinitializing_history",
    "historical_execution_dates_cannot_be_rewritten",
    "quality_failure_is_fail_closed_and_not_published_as_confirmed",
    "manual_skip_is_a_distinct_event_and_does_not_change_strategy_output",
    "at_least_twenty_trading_sessions_can_be_reconciled",
    "no_strategy_threshold_weight_or_execution_signal_is_changed",
    "no_secrets_private_account_data_or_credentials",
    "json_standard_library_compatible"
  ],
  "acceptance_gates": [
    "candidate_commit",
    "workspace_clean",
    "trusted_ref_separation",
    "policy_integrity",
    "context_registry",
    "task_scope",
    "ownership_scope",
    "protected_scope",
    "protected_manifest",
    "test_integrity",
    "developer_tests",
    "independent_tests",
    "golden_dataset",
    "negative_tests",
    "negative_fault_inputs",
    "fault_injection",
    "controlled_environment",
    "evidence_integrity"
  ],
  "stop_conditions": [
    "task_contract_missing_from_trusted_ref",
    "required_context_missing",
    "router_or_registry_malformed",
    "candidate_changes_outside_allowed_write_paths",
    "strategy_or_api_contract_changed",
    "arbitrary_client_weight_mapping_is_accepted",
    "target_snapshot_is_not_candidate_only_or_is_marked_order_ready",
    "execution_date_or_price_date_is_not_the_declared_next_session",
    "network_request_broker_client_order_or_secret_path_is_added",
    "adjusted_price_basis_double_counts_dividend_or_split",
    "cash_becomes_negative_or_positions_become_negative",
    "costs_slippage_or_fractional_share_policy_is_implicit",
    "nav_reconciliation_does_not_close",
    "same_day_conflict_is_silently_overwritten",
    "historical_ledger_or_portfolio_snapshot_is_updated_or_deleted",
    "restart_replays_events_or_loses_previous_positions",
    "quality_failure_is_promoted_to_confirmed_execution",
    "manual_skip_is_disguised_as_strategy_execution",
    "twenty_session_shadow_or_independent_reconciliation_is_missing",
    "test_failure_or_skipped_protected_test"
  ],
  "expected_artifacts": [
    "candidate_commit",
    "local_evidence_bundle",
    "ci_evidence_bundle",
    "paper_portfolio_schema_and_execution_contract",
    "twenty_session_paper_shadow_report",
    "ledger_idempotency_and_restart_report",
