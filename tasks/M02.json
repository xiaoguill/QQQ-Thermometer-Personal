{
  "$schema": "qqq-task-contract/v1",
  "task_id": "M02",
  "title": "Data Source Adapters and Raw Snapshot Manifest",
  "status": "approved",
  "change_class": "data_pipeline",
  "route_id": "data_pipeline",
  "role": "backend_builder",
  "base_ref": "verification-baseline-v2.1",
  "task_contract_authority": "trusted_ref_only",
  "requires_user_approval": true,
  "baseline_promotion_required": true,
  "required_context": [
    "AGENTS.md",
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "docs/trading_calendar_guide.md",
    "docs/QQQ_THERMOMETER_GOVERNANCE_BOUNDARIES.md",
    "docs/QQQ_VERIFICATION_GOVERNANCE_BASELINE.md",
    "docs/PERSONAL_USE_GOVERNANCE.md",
    "docs/QQQ_THERMOMETER_ARCHITECTURE.md",
    "docs/QQQ_THERMOMETER_MODULE_PLAN.md",
    "verification/README.md",
    "verification/control/policy.json",
    "verification/control/protected_manifest.json"
  ],
  "allowed_write_paths": [
    "src/storage/",
    "tests/integration/"
  ],
  "protected_write_paths": [],
  "forbidden_write_paths": [
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "tasks/",
    "docs/DOCUMENT_REGISTRY.json",
    "verification/",
    ".github/workflows/verification.yml",
    "configs/frozen/",
    "contracts/",
    "src/data/",
    "src/thermometer/",
    "src/api/",
    "src/jobs/",
    "frontend/",
    "src/web/",
    "research/",
    "docs/reference/",
    "data/"
  ],
  "invariants": [
    "frozen_strategy_contract_unchanged",
    "api_contract_unchanged",
    "no_strategy_or_indicator_logic",
    "no_data_refresh_in_tests_without_injected_transport",
    "raw_snapshots_are_append_only",
    "source_provenance_is_required",
    "source_failure_is_not_success",
    "no_unattributed_proxy_prices",
    "no_private_account_data",
    "no_real_broker_or_order_capability",
    "no_credentials_in_source_or_logs",
    "no_network_request_at_module_import",
    "canonical_manifest_is_deterministic"
  ],
  "acceptance_gates": [
    "candidate_commit",
    "workspace_clean",
    "trusted_ref_separation",
    "policy_integrity",
    "context_registry",
    "task_scope",
    "ownership_scope",
    "protected_scope",
    "protected_manifest",
    "test_integrity",
    "developer_tests",
    "independent_tests",
    "golden_dataset",
    "negative_tests",
    "negative_fault_inputs",
    "fault_injection",
    "controlled_environment",
    "evidence_integrity"
  ],
  "stop_conditions": [
    "task_contract_missing_from_trusted_ref",
    "required_context_missing",
    "router_or_registry_malformed",
    "candidate_changes_outside_allowed_write_paths",
    "strategy_or_api_contract_changed",
    "source_or_retrieval_timestamp_missing",
    "price_basis_or_timezone_missing",
    "failed_fetch_is_marked_success",
    "raw_snapshot_overwritten_or_silently_deduplicated",
    "private_account_or_broker_data_requested",
    "test_failure_or_skipped_protected_test"
  ],
  "expected_artifacts": [
    "candidate_commit",
    "local_evidence_bundle",
    "ci_evidence_bundle",
    "raw_snapshot_schema",
    "source_manifest_schema",
    "data_source_failure_report"
  ],
  "completion_status": {
    "builder_may_report": ["READY_FOR_VERIFICATION", "BASELINE_PROMOTION_REQUIRED"],
    "builder_may_not_report": ["VERIFIED", "CI_VERIFIED", "PRODUCT_BASELINE"]
  }
