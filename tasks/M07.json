    "reason_codes_and_regime_evidence_are_preserved",
    "output_is_candidate_only_and_not_order_ready",
    "service_is_pure_deterministic_idempotent_and_has_no_network_or_persistence",
    "no_private_account_data",
    "no_real_broker_or_order_capability",
    "no_network_request_at_module_import",
    "json_standard_library_compatible"
