{
  "$schema": "qqq-task-contract/v1",
  "task_id": "M12",
  "title": "Frontend Shell and Design Tokens",
  "status": "approved",
  "change_class": "frontend",
  "route_id": "frontend",
  "role": "frontend_builder",
  "base_ref": "verification-baseline-v3.13",
  "task_contract_authority": "trusted_ref_only",
  "requires_user_approval": true,
  "baseline_promotion_required": true,
  "required_context": [
    "AGENTS.md",
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "docs/QQQ_THERMOMETER_GOVERNANCE_BOUNDARIES.md",
    "docs/QQQ_VERIFICATION_GOVERNANCE_BASELINE.md",
    "docs/PERSONAL_USE_GOVERNANCE.md",
    "docs/QQQ_THERMOMETER_ARCHITECTURE.md",
    "docs/QQQ_THERMOMETER_MODULE_PLAN.md",
    "docs/FRONTEND_REFERENCE_BOUNDARIES.md",
    "tasks/M11.json",
    "frontend/AGENTS.md",
    "frontend/demo/README.md",
    "frontend/demo/index.html",
    "frontend/demo/styles.css",
    "frontend/demo/app.js",
    "contracts/openapi.json",
    "verification/README.md",
    "verification/control/policy.json",
    "verification/control/protected_manifest.json"
  ],
  "allowed_write_paths": [
    "frontend/",
    "tests/frontend/"
  ],
  "protected_write_paths": [],
  "forbidden_write_paths": [
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "tasks/",
    "docs/",
    "verification/",
    ".github/workflows/verification.yml",
    "configs/frozen/",
    "contracts/",
    "src/api/",
    "src/storage/",
    "src/jobs/",
    "src/thermometer/",
    "src/web/",
    "research/",
    "data/",
    "artifacts/"
  ],
  "invariants": [
    "frozen_strategy_contract_unchanged",
    "frozen_openapi_contract_unchanged",
    "router_ownership_and_verification_policy_unchanged",
    "frontend_is_presentation_only_and_consumes_versioned_api_contracts",
    "frontend_never_recomputes_strategy_indicators_temperature_or_target_weights",
    "strategy_versions_thresholds_weights_and_execution_rules_are_not_hardcoded",
    "data_timestamp_signal_confirmation_strategy_version_and_quality_are_visible",
    "loading_empty_partial_stale_failed_and_needs_review_states_are_explicit",
    "risk_colors_are_reinforced_by_text_and_icon_semantics",
    "desktop_narrow_keyboard_and_contrast_boundaries_are_preserved",
    "simulated_fixtures_are_explicitly_labeled_and_not_presented_as_live_data",
    "no_reference_site_code_brand_copy_text_asset_or_unique_visual_identity",
    "no_broker_order_transfer_secret_or_account_permission_capability",
    "no_external_market_data_source_or_unapproved_remote_service",
    "no_large_ui_runtime_dependency_without_separate_approval",
    "no_api_schema_backend_strategy_storage_or_scheduler_change"
  ],
  "acceptance_gates": [
    "candidate_commit",
    "workspace_clean",
    "trusted_ref_separation",
    "policy_integrity",
    "context_registry",
    "task_scope",
    "ownership_scope",
    "protected_scope",
    "protected_manifest",
    "test_integrity",
    "developer_tests",
    "independent_tests",
    "golden_dataset",
    "negative_tests",
    "negative_fault_inputs",
    "fault_injection",
    "controlled_environment",
    "evidence_integrity"
  ],
  "stop_conditions": [
    "task_contract_missing_from_trusted_ref",
    "required_context_missing",
    "router_or_registry_malformed",
    "candidate_changes_outside_allowed_write_paths",
    "strategy_or_api_contract_changed",
    "frontend_recomputes_strategy_or_accepts_client_authoritative_weights",
    "strategy_threshold_weight_version_or_execution_rule_is_hardcoded",
    "live_provisional_stale_partial_failed_or_needs_review_state_is_hidden_or_mislabeled",
    "risk_state_is_communicated_by_colour_without_text_or_icon",
    "keyboard_or_narrow_layout_boundary_is_broken",
    "reference_site_code_brand_text_asset_or_unique_visual_identity_is_copied",
    "broker_order_transfer_secret_account_permission_or_external_market_data_capability_is_added",
    "large_unapproved_ui_dependency_is_added",
    "api_backend_storage_strategy_or_scheduler_is_changed",
    "test_failure_or_skipped_protected_test"
  ],
  "expected_artifacts": [
    "candidate_commit",
    "local_evidence_bundle",
    "ci_evidence_bundle",
    "frontend_shell_and_design_token_report",
    "api_client_contract_compatibility_report",
    "responsive_keyboard_contrast_and_state_semantics_report",
    "no_strategy_or_order_boundary_report"
  ],
  "completion_status": {
    "builder_may_report": [
      "READY_FOR_VERIFICATION",
      "BASELINE_PROMOTION_REQUIRED"
    ],
    "builder_may_not_report": [
      "VERIFIED",
      "CI_VERIFIED",
      "PRODUCT_BASELINE"
    ]
  }
}
