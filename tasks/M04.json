{
  "$schema": "qqq-task-contract/v1",
  "task_id": "M04",
  "title": "Versioned Indicator Calculation",
  "status": "approved",
  "change_class": "data_pipeline",
  "route_id": "data_pipeline",
  "role": "backend_builder",
  "base_ref": "verification-baseline-v2.5",
  "task_contract_authority": "trusted_ref_only",
  "requires_user_approval": true,
  "baseline_promotion_required": true,
  "required_context": [
    "AGENTS.md",
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "docs/trading_calendar_guide.md",
    "docs/QQQ_THERMOMETER_GOVERNANCE_BOUNDARIES.md",
    "docs/QQQ_VERIFICATION_GOVERNANCE_BASELINE.md",
    "docs/PERSONAL_USE_GOVERNANCE.md",
    "docs/QQQ_THERMOMETER_ARCHITECTURE.md",
    "docs/QQQ_THERMOMETER_MODULE_PLAN.md",
    "configs/frozen/strategy_contract.json",
    "src/thermometer/AGENTS.md",
    "verification/README.md",
    "verification/control/policy.json",
    "verification/control/protected_manifest.json"
  ],
  "allowed_write_paths": [
    "src/storage/",
    "tests/integration/"
  ],
  "protected_write_paths": [],
  "forbidden_write_paths": [
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "tasks/",
    "docs/DOCUMENT_REGISTRY.json",
    "verification/",
    ".github/workflows/verification.yml",
    "configs/frozen/",
    "contracts/",
    "src/data/",
    "src/thermometer/",
    "src/api/",
    "src/jobs/",
    "frontend/",
    "src/web/",
    "research/",
    "docs/reference/",
    "data/"
  ],
  "invariants": [
    "frozen_strategy_contract_unchanged",
    "api_contract_unchanged",
    "no_strategy_state_or_weight_logic",
    "only_the_declared_first_batch_indicators_are_calculated",
    "indicator_definitions_are_versioned_and_explicit",
    "normalized_bars_are_the_only_market_data_input",
    "price_field_price_basis_timezone_and_calendar_are_retained",
    "signal_date_uses_data_through_signal_date_only",
    "rolling_windows_are_session_aligned_and_not_right_shifted",
    "future_bars_and_future_retrieval_metadata_are_rejected",
    "warmup_and_missing_values_are_explicit_not_filled",
    "non_ok_input_quality_cannot_become_confirmed_ready",
    "vix_term_structure_requires_same_date_nonzero_vix3m",
    "indicator_calculation_is_deterministic_and_idempotent",
    "no_private_account_data",
    "no_real_broker_or_order_capability",
    "no_network_request_at_module_import",
    "json_standard_library_compatible"
  ],
  "acceptance_gates": [
    "candidate_commit",
    "workspace_clean",
    "trusted_ref_separation",
    "policy_integrity",
    "context_registry",
    "task_scope",
    "ownership_scope",
    "protected_scope",
    "protected_manifest",
    "test_integrity",
    "developer_tests",
    "independent_tests",
    "golden_dataset",
    "negative_tests",
    "negative_fault_inputs",
    "fault_injection",
    "controlled_environment",
    "evidence_integrity"
  ],
  "stop_conditions": [
    "task_contract_missing_from_trusted_ref",
    "required_context_missing",
    "router_or_registry_malformed",
    "candidate_changes_outside_allowed_write_paths",
    "strategy_or_api_contract_changed",
    "unapproved_indicator_or_parameter_added",
    "indicator_definition_missing_window_or_price_basis",
    "future_bar_or_future_retrieval_accepted",
    "rolling_window_uses_future_or_wrong_signal_date",
    "missing_or_non_ok_bars_silently_filled_or_dropped",
    "warmup_or_nan_values_hidden_as_zero",
    "vix_term_structure_misaligned_or_divided_by_zero",
    "indicator_output_not_deterministic",
    "test_failure_or_skipped_protected_test"
  ],
  "expected_artifacts": [
    "candidate_commit",
    "local_evidence_bundle",
    "ci_evidence_bundle",
    "indicator_snapshot_schema",
    "indicator_definition_catalogue",
    "warmup_and_boundary_report",
    "anti_lookahead_report"
  ],
  "completion_status": {
    "builder_may_report": ["READY_FOR_VERIFICATION", "BASELINE_PROMOTION_REQUIRED"],
    "builder_may_not_report": ["VERIFIED", "CI_VERIFIED", "PRODUCT_BASELINE"]
  }
}
