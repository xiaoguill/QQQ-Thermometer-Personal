{
  "$schema": "qqq-task-contract/v1",
  "task_id": "M03",
  "title": "Standardization and Data Quality",
  "status": "approved",
  "change_class": "data_pipeline",
  "route_id": "data_pipeline",
  "role": "backend_builder",
  "base_ref": "verification-baseline-v2.4",
  "task_contract_authority": "trusted_ref_only",
  "requires_user_approval": true,
  "baseline_promotion_required": true,
  "required_context": [
    "AGENTS.md",
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "docs/trading_calendar_guide.md",
    "docs/QQQ_THERMOMETER_GOVERNANCE_BOUNDARIES.md",
    "docs/QQQ_VERIFICATION_GOVERNANCE_BASELINE.md",
    "docs/PERSONAL_USE_GOVERNANCE.md",
    "docs/QQQ_THERMOMETER_ARCHITECTURE.md",
    "docs/QQQ_THERMOMETER_MODULE_PLAN.md",
    "verification/README.md",
    "verification/control/policy.json",
    "verification/control/protected_manifest.json"
  ],
  "allowed_write_paths": [
    "src/storage/",
    "tests/integration/"
  ],
  "protected_write_paths": [],
  "forbidden_write_paths": [
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "tasks/",
    "docs/DOCUMENT_REGISTRY.json",
    "verification/",
    ".github/workflows/verification.yml",
    "configs/frozen/",
    "contracts/",
    "src/data/",
    "src/thermometer/",
    "src/api/",
    "src/jobs/",
    "frontend/",
    "src/web/",
    "research/",
    "docs/reference/",
    "data/"
  ],
  "invariants": [
    "frozen_strategy_contract_unchanged",
    "api_contract_unchanged",
    "no_strategy_or_indicator_logic",
    "raw_snapshots_are_not_overwritten",
    "raw_price_values_are_not_silently_adjusted",
    "trading_date_and_timezone_are_explicit",
    "no_future_bar_or_future_retrieval_is_accepted",
    "no_silent_gap_fill_or_proxy_price",
    "source_provenance_and_price_basis_are_retained",
    "quality_failure_blocks_confirmed_downstream_signal",
    "normalization_is_deterministic",
    "no_private_account_data",
    "no_real_broker_or_order_capability",
    "no_network_request_at_module_import",
    "json_standard_library_compatible"
  ],
  "acceptance_gates": [
    "candidate_commit",
    "workspace_clean",
    "trusted_ref_separation",
    "policy_integrity",
    "context_registry",
    "task_scope",
    "ownership_scope",
    "protected_scope",
    "protected_manifest",
    "test_integrity",
    "developer_tests",
    "independent_tests",
    "golden_dataset",
    "negative_tests",
    "negative_fault_inputs",
    "fault_injection",
    "controlled_environment",
    "evidence_integrity"
  ],
  "stop_conditions": [
    "task_contract_missing_from_trusted_ref",
    "required_context_missing",
    "router_or_registry_malformed",
    "candidate_changes_outside_allowed_write_paths",
    "strategy_or_api_contract_changed",
    "future_bar_or_future_retrieval_accepted",
    "non_trading_date_silently_normalized",
    "listing_before_date_silently_normalized",
    "duplicate_bar_silently_deduplicated",
    "cross_source_price_difference_hidden",
    "adjustment_factor_applied_without_provenance",
    "stale_or_failed_data_marked_ok",
    "quality_failure_allows_confirmed_signal",
    "test_failure_or_skipped_protected_test"
  ],
  "expected_artifacts": [
    "candidate_commit",
    "local_evidence_bundle",
    "ci_evidence_bundle",
    "normalized_bar_schema",
    "quality_event_schema",
    "calendar_and_listing_boundary_report",
    "data_quality_failure_report"
  ],
  "completion_status": {
    "builder_may_report": ["READY_FOR_VERIFICATION", "BASELINE_PROMOTION_REQUIRED"],
    "builder_may_not_report": ["VERIFIED", "CI_VERIFIED", "PRODUCT_BASELINE"]
  }
}
