    "required_context_missing",
    "router_or_registry_malformed",
    "candidate_changes_outside_allowed_write_paths",
    "m15_m16_m17_or_existing_frontend_files_changed",
    "strategy_or_frozen_api_contract_changed",
    "existing_m02_to_m07_logic_is_copied_or_reimplemented_in_m18",
    "failed_stale_partial_or_not_entitled_input_is_published_as_confirmed",
    "provisional_observation_changes_confirmed_target_weights_or_paper_ledger",
    "database_write_is_not_idempotent_or_paper_ledger_is_mutable",
    "massive_api_key_is_committed_logged_returned_to_browser_or_sent_as_query_parameter",
    "frontend_reimplements_strategy_or_hardcodes_weights_thresholds_or_module_truth",
    "external_api_broker_order_transfer_scheduler_public_deployment_or_real_trading_capability_is_added",
    "test_failure_or_skipped_protected_test"
