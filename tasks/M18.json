  "invariants": [
    "m18_is_additive_and_does_not_change_m15_m16_m17_or_existing_frontend_runtime_behavior",
    "m00_5_to_m15_are_displayed_as_provenance_and_module_statuses_not_as_a_second_strategy",
    "full_chain_reuses_existing_m02_to_m07_data_quality_indicators_regime_explanation_and_target_services_without_copying_frozen_rules",
    "raw_market_inputs_are_immutable_normalized_quality_is_explicit_and_failed_or_stale_inputs_fail_closed",
    "m04_to_m07_outputs_carry_source_version_run_id_as_of_signal_date_execution_date_and_quality",
    "m08_sqlite_is_the_only_m18_persistent_read_model_write_boundary_and_runs_are_idempotent",
    "m09_is_append_only_paper_ledger_and_never_creates_broker_orders_or_transfers",
    "m10_compatibility_is_read_only_and_m11_run_state_is_explicit_and_replayable",
    "m16_provisional_observation_is_separate_from_formal_confirmed_strategy_and_cannot_change_confirmed_targets",
    "frontend_reads_all_m18_values_from_backend_and_contains_no_strategy_thresholds_or_hardcoded_weights",
    "massive_api_key_is_process_environment_only_and_never_enters_repository_logs_browser_or_query_parameters",
    "local_runtime_is_loopback_only_paper_only_and_has_no_scheduler_broker_or_public_deployment",
    "display_timezone_is_Asia_Shanghai_and_internal_event_timestamps_remain_UTC",
    "no_frozen_strategy_api_contract_governance_file_existing_module_file_or_historical_artifact_is_changed"
  ],
