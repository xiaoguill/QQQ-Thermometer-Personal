{
  "$schema": "qqq-task-contract/v1",
  "task_id": "M10",
  "title": "Local Read-Only API and Paper Confirmation",
  "status": "approved",
  "change_class": "backend",
  "route_id": "backend",
  "role": "backend_builder",
  "base_ref": "verification-baseline-v3.10",
  "task_contract_authority": "trusted_ref_only",
  "requires_user_approval": true,
  "baseline_promotion_required": true,
  "required_context": [
    "AGENTS.md",
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "docs/QQQ_THERMOMETER_GOVERNANCE_BOUNDARIES.md",
    "docs/QQQ_VERIFICATION_GOVERNANCE_BASELINE.md",
    "docs/PERSONAL_USE_GOVERNANCE.md",
    "docs/QQQ_THERMOMETER_ARCHITECTURE.md",
    "docs/QQQ_THERMOMETER_MODULE_PLAN.md",
    "contracts/README.md",
    "contracts/openapi.json",
    "tasks/M09.json",
    "src/api/AGENTS.md",
    "src/storage/sqlite_store.py",
    "src/storage/paper_portfolio.py",
    "src/thermometer/regime.py",
    "src/thermometer/explanation.py",
    "src/thermometer/target_weights.py",
    "verification/README.md",
    "verification/control/policy.json",
    "verification/control/protected_manifest.json"
  ],
  "allowed_write_paths": [
    "src/api/",
    "tests/integration/"
  ],
  "protected_write_paths": [],
  "forbidden_write_paths": [
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "tasks/",
    "docs/DOCUMENT_REGISTRY.json",
    "verification/",
    ".github/workflows/verification.yml",
    "configs/frozen/",
    "contracts/",
    "src/thermometer/",
    "src/storage/",
    "src/jobs/",
    "src/web/",
    "frontend/",
    "research/",
    "data/"
  ],
  "invariants": [
    "frozen_openapi_contract_unchanged",
    "frozen_strategy_contract_unchanged",
    "router_ownership_and_verification_policy_unchanged",
    "all_declared_api_paths_have_versioned_json_responses",
    "response_metadata_contains_contract_strategy_time_signal_execution_quality_and_run",
    "api_reads_repository_models_and_never_recomputes_strategy_or_indicators",
    "temperature_colour_agreement_and_client_weights_are_not_authoritative_inputs",
    "pagination_and_date_filters_are_bounded_and_deterministic",
    "empty_stale_partial_failed_and_needs_review_states_are_explicit",
    "local_access_policy_rejects_non_local_clients_and_never_logs_tokens",
    "http_server_binds_localhost_by_default_and_does_not_start_on_import",
    "only_paper_confirmation_may_write_and_it_creates_no_order_or_portfolio_execution",
    "paper_confirmation_requires_decision_and_idempotency_key",
    "paper_confirmation_replay_is_idempotent_and_conflict_is_rejected",
    "no_direct_sql_table_access_from_route_handlers",
    "no_network_data_source_broker_secret_or_external_service",
    "no_cors_public_auth_or_account_data_expansion",
    "stdlib_only_no_new_runtime_dependency",
    "json_schema_and_error_semantics_match_frozen_openapi",
    "no_change_to_strategy_weights_execution_timing_or_historical_results"
  ],
  "acceptance_gates": [
    "candidate_commit",
    "workspace_clean",
    "trusted_ref_separation",
    "policy_integrity",
    "context_registry",
    "task_scope",
    "ownership_scope",
    "protected_scope",
    "protected_manifest",
    "test_integrity",
    "developer_tests",
    "independent_tests",
    "golden_dataset",
    "negative_tests",
    "negative_fault_inputs",
    "fault_injection",
    "controlled_environment",
    "evidence_integrity"
  ],
  "stop_conditions": [
    "task_contract_missing_from_trusted_ref",
    "required_context_missing",
    "router_or_registry_malformed",
    "candidate_changes_outside_allowed_write_paths",
    "openapi_or_strategy_contract_changed",
    "route_recomputes_strategy_indicator_or_target_weight",
    "client_supplied_weight_temperature_colour_or_state_is_accepted_as_truth",
    "unbounded_query_or_pagination_is_accepted",
    "empty_or_stale_data_is_silently_presented_as_confirmed",
    "remote_client_is_allowed_by_default",
    "server_binds_non_localhost_by_default",
    "token_or_private_data_is_logged_or_persisted",
    "non_confirmation_write_endpoint_or_order_capability_is_added",
    "confirmation_replay_duplicates_or_conflict_overwrites_event",
    "route_bypasses_repository_with_direct_sql",
    "network_external_service_broker_or_new_dependency_is_added",
    "schema_response_does_not_match_frozen_openapi",
    "test_failure_or_skipped_protected_test"
  ],
  "expected_artifacts": [
    "candidate_commit",
    "local_evidence_bundle",
    "ci_evidence_bundle",
    "openapi_response_compatibility_report",
    "endpoint_error_and_pagination_matrix",
    "local_access_and_no_order_boundary_report",
    "paper_confirmation_idempotency_report"
  ],
  "completion_status": {
    "builder_may_report": [
      "READY_FOR_VERIFICATION",
      "BASELINE_PROMOTION_REQUIRED"
    ],
    "builder_may_not_report": [
      "VERIFIED",
      "CI_VERIFIED",
      "PRODUCT_BASELINE"
    ]
  }
}
