{
  "$schema": "qqq-task-contract/v1",
  "task_id": "M06",
  "title": "Thermometer Explanation Presentation Model",
  "status": "approved",
  "change_class": "strategy_domain",
  "route_id": "strategy_domain",
  "role": "domain_builder",
  "base_ref": "verification-baseline-v3.0",
  "task_contract_authority": "trusted_ref_only",
  "requires_user_approval": true,
  "baseline_promotion_required": true,
  "required_context": [
    "AGENTS.md",
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "docs/QQQ_THERMOMETER_GOVERNANCE_BOUNDARIES.md",
    "docs/QQQ_VERIFICATION_GOVERNANCE_BASELINE.md",
    "docs/PERSONAL_USE_GOVERNANCE.md",
    "docs/QQQ_THERMOMETER_ARCHITECTURE.md",
    "docs/QQQ_THERMOMETER_MODULE_PLAN.md",
    "configs/frozen/strategy_contract.json",
    "contracts/openapi.json",
    "src/thermometer/AGENTS.md",
    "src/thermometer/regime.py",
    "src/storage/indicators.py",
    "verification/README.md",
    "verification/control/policy.json",
    "verification/control/protected_manifest.json"
  ],
  "allowed_write_paths": [
    "src/thermometer/",
    "tests/unit/",
    "tests/integration/",
    "tests/e2e/"
  ],
  "protected_write_paths": [],
  "forbidden_write_paths": [
    "OWNERSHIP.yaml",
    "AI_CONTEXT_ROUTER.json",
    "tasks/",
    "docs/DOCUMENT_REGISTRY.json",
    "verification/",
    ".github/workflows/verification.yml",
    "configs/frozen/",
    "contracts/",
    "src/data/",
    "src/storage/",
    "src/api/",
    "src/jobs/",
    "frontend/",
    "src/web/",
    "research/",
    "docs/reference/",
    "data/"
  ],
  "invariants": [
    "frozen_strategy_contract_unchanged",
    "api_contract_unchanged",
    "strategy_version_must_remain_v10_preserve_shock_recovery",
    "legacy_strategy_is_not_relabelled_or_modified",
    "explanation_model_is_pure_and_has_no_network_persistence_ui_or_order_access",
    "inputs_are_m05_regime_snapshot_and_m04_indicator_snapshot_only",
    "regime_snapshot_and_indicator_snapshot_must_share_signal_date_and_provenance",
    "temperature_is_a_presentation_scale_not_a_strategy_parameter",
    "temperature_and_state_color_and_label_are_explicitly_consistent",
    "trend_uses_only_declared_m04_directional_indicators",
    "signal_agreement_is_directional_consistency_not_return_probability_or_win_rate",
    "confidence_label_is_publication_state_not_statistical_confidence",
    "explanation_never_recomputes_or_changes_regime_state",
    "explanation_never_creates_or_changes_target_weights",
    "passed_and_failed_regime_evidence_is_preserved",
    "missing_or_non_ok_indicators_are_explicit_and_never_silently_filled",
    "intraday_or_provisional_observations_cannot_be_published_as_final",
    "warming_needs_review_and_unconfirmed_states_cannot_be_final_confirmed",
    "signal_date_and_as_of_provenance_are_retained_without_future_fields",
    "same_input_is_deterministic_and_idempotent",
    "no_historical_return_based_mapping_or_optimization",
    "no_private_account_data",
    "no_real_broker_or_order_capability",
    "no_network_request_at_module_import",
    "json_standard_library_compatible"
  ],
  "acceptance_gates": [
    "candidate_commit",
    "workspace_clean",
    "trusted_ref_separation",
    "policy_integrity",
    "context_registry",
    "task_scope",
    "ownership_scope",
    "protected_scope",
    "protected_manifest",
    "test_integrity",
    "developer_tests",
    "independent_tests",
    "golden_dataset",
    "negative_tests",
    "negative_fault_inputs",
    "fault_injection",
    "controlled_environment",
    "evidence_integrity"
  ],
  "stop_conditions": [
    "task_contract_missing_from_trusted_ref",
    "required_context_missing",
    "router_or_registry_malformed",
    "candidate_changes_outside_allowed_write_paths",
    "strategy_or_api_contract_changed",
    "legacy_strategy_or_v10_name_confused",
    "temperature_or_color_used_to_drive_state_or_weights",
    "agreement_mapped_to_probability_or_return_forecast",
    "new_indicator_threshold_asset_weight_or_strategy_parameter_added",
    "regime_snapshot_recomputed_or_overridden",
    "missing_indicator_silently_filled_or_hidden",
    "stale_partial_failed_or_needs_review_data_published_as_confirmed",
    "intraday_provisional_data_published_as_close_confirmed",
    "state_text_color_and_temperature_are_inconsistent",
    "future_field_or_future_data_used",
    "same_input_is_not_idempotent",
    "test_failure_or_skipped_protected_test"
  ],
  "expected_artifacts": [
    "candidate_commit",
    "local_evidence_bundle",
    "ci_evidence_bundle",
    "explanation_model_schema",
    "state_temperature_mapping_matrix",
    "directional_agreement_report",
    "quality_and_provisional_report"
  ],
  "completion_status": {
    "builder_may_report": [
      "READY_FOR_VERIFICATION",
      "BASELINE_PROMOTION_REQUIRED"
    ],
    "builder_may_not_report": [
      "VERIFIED",
      "CI_VERIFIED",
      "PRODUCT_BASELINE"
    ]
  }
}
